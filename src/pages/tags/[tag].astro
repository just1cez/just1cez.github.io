---
import PageLayout from "../../layouts/PageLayout.astro";
import { CATEGORY_META, SITE } from "../../site.config";
import { getAllPosts, getTagGroups } from "../../lib/posts";

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const tags = getTagGroups(allPosts);
  return tags.map((data) => ({ params: { tag: data.slug }, props: { tag: data.tag, posts: data.posts } }));
}

const { tag, posts } = Astro.props;
---

<PageLayout title={`Tag: ${tag} — ${SITE.title}`} description={`浏览标签 ${tag} 下的文章。`}>
  <header class="page-heading">
    <h1 class="page-title">#{tag}</h1>
    <p class="mt-2 text-sm text-muted">{posts.length} 篇文章</p>
  </header>

  <div class="divide-y divide-border">
    {posts.map((post) => (
      <article class="py-5 sm:grid sm:grid-cols-[112px_minmax(0,1fr)] sm:gap-6">
        <div class="mb-2 text-xs text-muted sm:mb-0 sm:pt-1">
          <time datetime={post.date.toISOString()}>{post.date.toLocaleDateString("zh-CN")}</time>
          <span class="ml-2 sm:ml-0 sm:mt-1 sm:block">{CATEGORY_META[post.category].label}</span>
        </div>
        <div>
          <h2 class="font-serif text-xl font-semibold text-fg"><a href={post.href} class="hover:text-link">{post.title}</a></h2>
          {post.description && <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted">{post.description}</p>}
        </div>
      </article>
    ))}
  </div>
</PageLayout>
