---
import PageLayout from "../../layouts/PageLayout.astro";
import FrostLine from "../../components/FrostLine.astro";
import { CATEGORY_META, tagPath } from "../../site.config";
import { getAllPosts, getTagGroups } from "../../lib/posts";

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const tags = getTagGroups(allPosts);

  return tags.map((data) => ({
    params: { tag: data.slug },
    props: {
      tag: data.tag,
      posts: data.posts,
    },
  }));
}

const { tag, posts } = Astro.props;
---

<PageLayout title={`Tag: ${tag} - Justice's Blog`} description={`浏览标签 ${tag} 下的文章。`}>
  <div class="space-y-8">
    <header class="space-y-2 frost-fade-up">
      <span class="block font-mono text-xs uppercase tracking-widest text-accentWarm">Tag Focus / 标签聚焦</span>
      <h1 class="font-serif text-2xl font-bold text-fg sm:text-3.5xl">#{tag}</h1>
      <p class="font-serif text-xs italic text-fgMuted">共 {posts.length} 篇文章，按时间从近到远排列。</p>
      <FrostLine />
    </header>

    <ul class="space-y-3">
      {posts.map((post) => (
        <li>
          <article class="rounded-md border border-border/70 bg-bgSoft/35 p-4 transition-colors hover:border-accent dark:bg-bgSoft/20">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0 space-y-1">
                <a href={post.href} class="line-clamp-2 font-serif text-sm font-bold text-fg transition-colors hover:text-accent">
                  {post.title}
                </a>
                {post.description && <p class="line-clamp-2 text-sm leading-relaxed text-fgMuted">{post.description}</p>}
              </div>
              <time datetime={post.date.toISOString()} class="shrink-0 font-mono text-[11px] text-fgMuted">
                {post.date.toLocaleDateString("zh-CN")}
              </time>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-fgMuted">
              <span class="rounded bg-accent/10 px-1.5 py-0.5 text-accent">{CATEGORY_META[post.category].label}</span>
              {post.tags.map((item) => (
                <a href={tagPath(item)} class:list={["inline-flex min-h-8 items-center rounded border border-border px-2 py-1 transition-colors hover:border-accent hover:text-accent", item === tag && "border-accent/40 bg-accent/10 text-accent"]}>#{item}</a>
              ))}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</PageLayout>
