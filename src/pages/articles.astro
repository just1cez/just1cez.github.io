---
import ArticleList from "../components/ArticleList.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getAllPosts, getCategoryCounts, getPostArchiveYearGroups } from "../lib/posts";
import { SITE, categoryPath, withBase } from "../site.config";

const posts = await getAllPosts();
const categoryCounts = getCategoryCounts(posts);
const yearGroups = getPostArchiveYearGroups(posts);
---

<PageLayout title={`文章 — ${SITE.title}`} description="Justice 的全部文章。">
  <header class="page-heading">
    <h1 class="page-title">文章</h1>
    <p class="mt-2 text-sm text-muted">{posts.length} 篇文章</p>
  </header>

  <nav class="flex flex-wrap gap-x-5 gap-y-2 border-b border-border py-5 text-sm" aria-label="文章浏览">
    <span aria-current="page" class="border-b border-link pb-1 text-fg">全部 {posts.length}</span>
    <a href={categoryPath("tech")} class="pb-1 text-link">技术 {categoryCounts.tech ?? 0}</a>
    <a href={categoryPath("life")} class="pb-1 text-link">生活 {categoryCounts.life ?? 0}</a>
    <a href={withBase("/tags")} class="pb-1 text-link">标签</a>
    <a href={withBase("/series")} class="pb-1 text-link">系列</a>
  </nav>

  <div class="space-y-10 py-8">
    {yearGroups.map((group) => (
      <section aria-labelledby={`archive-year-${group.year}`}>
        <h2 id={`archive-year-${group.year}`} class="border-b border-border pb-3 font-serif text-2xl font-semibold text-fg">
          {group.year}
        </h2>
        <ArticleList posts={group.posts} showReadingTime />
      </section>
    ))}
  </div>
</PageLayout>
