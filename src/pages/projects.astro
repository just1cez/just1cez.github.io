---
import PageLayout from "../layouts/PageLayout.astro";
import { postPath } from "../site.config";

const projectGroups = [
  {
    label: "项目档案",
    items: [
      {
        title: "Justice's Blog",
        status: "持续维护",
        description: "用 Astro 搭建个人知识库，记录课程、算法、AI 入门和硬件折腾。",
        tags: ["Astro", "Tailwind", "GitHub Pages", "写作系统"],
      },
      {
        title: "250 元垃圾装机",
        status: "已记录",
        href: postPath("life", "junk-pc-build"),
        description: "从闲鱼配件到成功点亮，一次低预算硬件折腾记录。",
        tags: ["PC 硬件", "装机", "折腾记录"],
      },
    ],
  },
  {
    label: "想做",
    items: [
      {
        title: "本地 Bot / 小服务器",
        status: "想开始",
        description: "利用闲置硬件尝试 Bot、Docker 和本地服务部署。",
        tags: ["Bot", "Docker", "Home Lab"],
      },
      {
        title: "AI Infra 学习实验",
        status: "想开始",
        description: "从 Python、模型调用、简单部署开始，慢慢理解 AI 应用背后的工程部分。",
        tags: ["AI Infra", "Python", "Machine Learning"],
      },
    ],
  },
];
---

<PageLayout title="Projects - Justice's Blog" description="Justice 的项目档案、硬件折腾和未来想做的小实验。">
  <header class="mb-8 border-b border-border pb-5">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">Projects</p>
    <h1 class="mt-2 text-2xl font-bold font-serif-cn">项目档案与折腾记录</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-fgMuted">
      这里先不装成成熟作品集，更像一个存档架：已经做过的、正在维护的、以及想开始尝试的小项目都会放在这里。
    </p>
  </header>

  <div class="space-y-8">
    {projectGroups.map((group) => (
      <section>
        <h2 class="mb-3 text-lg font-semibold">{group.label}</h2>
        <div class="grid gap-3">
          {group.items.map((item) => {
            const Tag = item.href ? "a" : "article";
            const props = item.href ? { href: item.href } : {};
            return (
              <Tag {...props} class="block rounded-md border border-border bg-bgSoft p-4 transition-colors hover:border-accent">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                  <h3 class="font-medium">{item.title}</h3>
                  <span class="w-fit rounded bg-bg px-2 py-0.5 text-xs text-fgMuted">{item.status}</span>
                </div>
                <p class="mt-2 text-sm leading-6 text-fgMuted">{item.description}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <span class="whitespace-nowrap rounded bg-bg px-2 py-0.5 text-xs text-fgMuted">{tag}</span>
                  ))}
                </div>
              </Tag>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</PageLayout>
