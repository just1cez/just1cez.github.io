---
import ArticleList from "../components/ArticleList.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getAllPosts, toPostCardItem } from "../lib/posts";
import { SITE } from "../site.config";

const posts = (await getAllPosts())
  .filter((post) => post.data.series === "Rust 学习笔记")
  .map(toPostCardItem);
---

<PageLayout title={`Rust 学习笔记 — ${SITE.title}`} description="从基础语法、所有权与借用到小项目实践，记录 Rust 的学习过程。" noindex={posts.length === 0}>
  <header class="page-heading">
    <h1 class="page-title">Rust 学习笔记</h1>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">从基础语法、所有权与借用到小项目实践，记录 Rust 的学习过程。</p>
    <p class="mt-2 text-sm text-muted">{posts.length} 篇笔记 · 持续更新</p>
  </header>

  {posts.length > 0 ? (
    <ArticleList posts={posts} showReadingTime />
  ) : (
    <div class="border-t border-border py-8">
      <h2 class="font-serif text-xl font-semibold text-fg">从这里开始</h2>
      <p class="mt-3 text-sm leading-7 text-muted">栏目已开通，第一篇笔记正在路上。</p>
    </div>
  )}
</PageLayout>
