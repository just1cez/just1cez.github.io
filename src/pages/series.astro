---
import PageLayout from "../layouts/PageLayout.astro";
import { getAllPosts, getSeriesGroups } from "../lib/posts";
import { SITE } from "../site.config";

const posts = await getAllPosts();
const { groupedSeries, singletonSeries } = getSeriesGroups(posts);
const seriesCount = groupedSeries.length + singletonSeries.length;
---

<PageLayout title={`Series — ${SITE.title}`} description="按系列浏览文章。">
  <header class="page-heading">
    <h1 class="page-title">系列</h1>
    <p class="mt-2 text-sm text-muted">{seriesCount} 个系列</p>
  </header>

  <div class="divide-y divide-border">
    {groupedSeries.map((group) => (
      <section class="py-7" aria-labelledby={`series-${group.name}`}>
        <div class="flex items-baseline justify-between gap-4">
          <h2 id={`series-${group.name}`} class="font-serif text-xl font-semibold text-fg">{group.name}</h2>
          <span class="shrink-0 text-xs text-muted">{group.count} 篇</span>
        </div>
        <ul class="mt-3 space-y-2">
          {group.posts.map((post) => (
            <li class="flex items-baseline justify-between gap-4 text-sm">
              <a href={post.href} class="min-w-0 text-fg hover:text-link">{post.title}</a>
              <time datetime={post.date.toISOString()} class="shrink-0 text-xs text-muted">{post.date.toLocaleDateString("zh-CN")}</time>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {singletonSeries.map(({ name, post }) => (
      <section class="py-7">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-xl font-semibold text-fg">{name}</h2>
          <span class="shrink-0 text-xs text-muted">1 篇</span>
        </div>
        <a href={post.href} class="mt-3 block text-sm text-fg hover:text-link">{post.title}</a>
      </section>
    ))}
  </div>
</PageLayout>
