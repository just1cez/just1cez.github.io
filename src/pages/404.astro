---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, withBase } from "../site.config";
---

<BaseLayout title={`404 — ${SITE.title}`} description="页面不存在">
  <div class="min-h-screen flex flex-col items-center justify-center px-4">
    <h1 class="text-6xl font-bold text-muted">404</h1>
    <p class="mt-4 text-lg text-muted">页面不存在</p>
    <a href={withBase("/")} class="mt-6 text-sm text-link">返回首页</a>
  </div>
</BaseLayout>
