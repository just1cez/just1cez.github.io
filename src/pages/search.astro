---
import PageLayout from "../layouts/PageLayout.astro";
import SearchIsland from "../components/react/SearchIsland.tsx";
import { CATEGORY_META, SITE, withBase } from "../site.config";
import { getAllPosts, toPostSummary } from "../lib/posts";

const fallbackPosts = (await getAllPosts()).slice(0, 12).map(toPostSummary);
---

<PageLayout title={`Search — ${SITE.title}`} description="搜索博客文章。">
  <SearchIsland client:load indexUrl={withBase("/search.json")} />
  <noscript>
    <section class="mt-8 space-y-4 border-t border-border pt-5">
      <div class="space-y-1">
        <h2 class="font-serif text-base font-semibold text-fg">最近文章</h2>
        <p class="text-xs leading-relaxed text-muted">启用 JavaScript 后可以搜索全文。</p>
      </div>
      <ul class="space-y-3">
        {fallbackPosts.map((post) => (
          <li>
            <a href={post.href} class="font-serif text-sm font-semibold text-fg hover:text-link">{post.title}</a>
            <div class="mt-1 flex flex-wrap items-center gap-2 font-mono text-[11px] text-muted">
              <span>{post.date.toLocaleDateString("zh-CN")}</span>
              <span>{CATEGORY_META[post.category].label}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </noscript>
</PageLayout>
