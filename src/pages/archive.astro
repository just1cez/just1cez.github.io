---
import PageLayout from "../layouts/PageLayout.astro";
import FrostLine from "../components/FrostLine.astro";
import { CATEGORY_META, POST_STAGE_META, postPath } from "../site.config";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();
const groupedPosts = posts.reduce((groups, post) => {
  const year = post.data.date.getFullYear();
  const month = post.data.date.getMonth() + 1;
  if (!groups.has(year)) groups.set(year, new Map<number, typeof posts>());
  const yearGroup = groups.get(year)!;
  if (!yearGroup.has(month)) yearGroup.set(month, []);
  yearGroup.get(month)!.push(post);
  return groups;
}, new Map<number, Map<number, typeof posts>>());
---

<PageLayout title="Archive - Justice's Blog" description="按年份浏览所有文章。">
  <div class="space-y-10">
    <header class="space-y-2 frost-fade-up">
      <span class="block font-mono text-xs uppercase tracking-widest text-accentWarm">Timeline / 时间之流</span>
      <h1 class="font-serif text-2xl font-bold text-fg sm:text-3.5xl">文章归档</h1>
      <p class="font-serif text-xs italic text-fgMuted">共 {posts.length} 篇，按发布时间倒序排列。</p>
      <FrostLine />
    </header>

    <div class="relative ml-2 space-y-12 border-l border-border/60 pl-4 sm:pl-6 frost-fade-up">
      {Array.from(groupedPosts.entries()).map(([year, months]) => (
        <div class="relative space-y-6">
          <span class="absolute -left-[25px] top-1.5 z-10 flex h-5 w-5 items-center justify-center rounded-full border-2 border-accent bg-bg shadow-sm sm:-left-[33px]">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          </span>
          <h2 class="pl-2 font-serif text-xl font-bold tracking-wide text-accent">{year} 年</h2>
          <div class="space-y-8 pl-2">
            {Array.from(months.entries()).map(([month, monthPosts]) => (
              <div class="space-y-4">
                <h3 class="flex w-fit items-center gap-1.5 border-b border-border/20 pb-1 font-mono text-xs font-bold uppercase text-accentWarm">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 5v5l3 3" /></svg>
                  <span>{month.toString().padStart(2, "0")} 月</span>
                </h3>
                <div class="space-y-3 pl-2 sm:pl-4">
                  {monthPosts.map((post) => (
                    <a href={postPath(post.data.category, post.id)} class="group flex flex-col justify-between gap-2 rounded border border-border/40 bg-bgSoft/15 p-3.5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-bgSoft/40 sm:flex-row sm:items-center">
                      <div class="space-y-1">
                        <div class="flex flex-wrap items-center gap-2 font-mono text-[9px] text-fgMuted">
                          <span>{post.data.date.toLocaleDateString("zh-CN")}</span>
                          <span class="rounded border border-border/60 bg-bgSoft px-1.5 py-0.5">{POST_STAGE_META[post.data.stage].label}</span>
                        </div>
                        <h4 class="font-serif text-[14px] font-bold leading-snug text-fg transition-colors group-hover:text-accent">{post.data.title}</h4>
                      </div>
                      <span class="shrink-0 self-end font-mono text-[9px] uppercase tracking-wide text-fgMuted opacity-80 sm:self-center">{CATEGORY_META[post.data.category].label}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</PageLayout>
