---
import PageLayout from "../../layouts/PageLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { CATEGORY_META, categoryPath } from "../../site.config";
import { getPostsByCategory } from "../../lib/posts";

export async function getStaticPaths({ paginate }) {
  const posts = await getPostsByCategory("tech");
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<PageLayout title="Tech - Justice's Blog" description={CATEGORY_META.tech.description} type="tech">
  <header class="mb-8 border-b border-border pb-5">
    <h1 class="text-2xl font-bold">{CATEGORY_META.tech.title}</h1>
    <p class="mt-2 text-sm text-fgMuted">{CATEGORY_META.tech.description}</p>
  </header>
  <div class="space-y-3">
    {page.data.map((post) => (
      <PostCard
        title={post.data.title}
        date={post.data.date}
        tags={post.data.tags}
        category={post.data.category}
        description={post.data.description}
        slug={post.id}
        series={post.data.series}
        stage={post.data.stage}
        draft={post.data.draft}
      />
    ))}
  </div>
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} baseUrl={categoryPath("tech")} />
</PageLayout>
