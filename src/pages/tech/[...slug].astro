---
import PostLayout from "../../layouts/PostLayout.astro";
import PrevNext from "../../components/PrevNext.astro";
import { render } from "astro:content";
import { getPostsByCategory } from "../../lib/posts";
import { postPath } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getPostsByCategory("tech");

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: i < posts.length - 1 ? { title: posts[i + 1].data.title, slug: posts[i + 1].id, category: "tech" } : null,
      next: i > 0 ? { title: posts[i - 1].data.title, slug: posts[i - 1].id, category: "tech" } : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const canonicalUrl = new URL(postPath(post.data.category, post.id), Astro.site).toString();
---

<PostLayout
  title={post.data.title}
  date={post.data.date}
  tags={post.data.tags}
  category={post.data.category}
  description={post.data.description}
  image={post.data.cover}
  canonicalUrl={canonicalUrl}
  headings={headings}
>
  <Content />
  <PrevNext prev={prev} next={next} />
</PostLayout>
