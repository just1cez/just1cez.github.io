---
import PageLayout from "../layouts/PageLayout.astro";
import { SITE, categoryPath, postPath, withBase } from "../site.config";

const focusItems = ["算法", "C++", "深度学习", "图像复原", "工程实践", "硬件折腾"];
const recommendedPosts = [
  {
    title: "C++ 竞赛常用技巧速查",
    href: postPath("tech", "cpp-tips"),
    note: "常用模板和编码习惯，适合作为算法学习的工具箱。",
  },
  {
    title: "DGOSR 读书笔记",
    href: postPath("tech", "dgosr"),
    note: "图优化、ADMM 展开和深度图超分辨率的一篇论文整理。",
  },
  {
    title: "LGCNet 解读",
    href: postPath("tech", "lgcnet"),
    note: "从像素一致性到梯度一致性，理解可解释图像去噪网络。",
  },
  {
    title: "250 元垃圾装机",
    href: postPath("life", "junk-pc-build"),
    note: "一台二手主机从配件到点亮的完整折腾记录。",
  },
];

const readingRoutes = [
  ["技术笔记", categoryPath("tech"), "算法、论文阅读和工程实践。"],
  ["标签索引", withBase("/tags"), "按主题回看长期关注点。"],
  ["文章归档", withBase("/archive"), "按时间线查看全部更新。"],
  ["站内搜索", withBase("/search"), "需要找旧内容时最快。"],
] as const;
---

<PageLayout
  title="About / Start Here - Justice's Blog"
  description="关于 Justice，以及这个博客的推荐阅读入口。"
>
  <header class="mb-10 border-b border-border pb-7">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <img src={withBase(SITE.avatar)} alt="Justice" class="h-20 w-20 rounded-full object-cover ring-1 ring-border" />
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">About / Start Here</p>
        <h1 class="mt-2 text-2xl font-bold font-serif-cn">{SITE.author}</h1>
        <p class="mt-1 text-sm text-fgMuted">HITSZ CS · 算法、论文与工程实践学习中</p>
      </div>
    </div>
    <p class="mt-5 max-w-3xl leading-7 text-fgMuted">
      这个站用来保存我正在建立的计算机基础、论文阅读笔记、工程折腾和一些生活记录。
      我希望它最后像一个能反复回头查的知识花园：文章不只是写完就放下，而是随着学习继续修订、补充和互相连接。
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      {focusItems.map((item) => (
        <span class="rounded bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent">
          #{item}
        </span>
      ))}
    </div>
  </header>

  <div class="space-y-10">
    <section>
      <div class="mb-4 flex items-baseline justify-between border-b border-border pb-2">
        <h2 class="text-xl font-semibold">先读这些</h2>
        <span class="text-xs text-fgMuted">最快知道这个站在写什么</span>
      </div>
      <div class="grid gap-3">
        {recommendedPosts.map((post) => (
          <a href={post.href} class="block rounded-md border border-border bg-bg p-4 hover:border-accent transition-colors">
            <h3 class="font-medium hover:text-accent">{post.title}</h3>
            <p class="mt-2 text-sm leading-6 text-fgMuted">{post.note}</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="mb-3 text-xl font-semibold">正在关注</h2>
      <p class="leading-7 text-fgMuted">
        短期会继续补算法竞赛基础、C++ 常用模板、深度学习和图像复原方向的论文阅读。
        工程侧会把能跑起来的项目、部署经验和踩坑过程整理成复盘；生活区则保留一些硬件、工具和日常观察。
      </p>
    </section>

    <section>
      <h2 class="mb-3 text-xl font-semibold">怎么阅读</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {readingRoutes.map(([label, href, note]) => (
          <a href={href} class="rounded-md border border-border bg-bgSoft p-4 hover:border-accent hover:text-accent transition-colors">
            <span class="font-medium">{label}</span>
            <span class="mt-1 block text-sm leading-6 text-fgMuted">{note}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="border-t border-border pt-6">
      <div class="flex flex-wrap gap-3 text-sm">
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="rounded border border-border px-3 py-1.5 hover:border-accent hover:text-accent transition-colors">GitHub</a>
        <a href={withBase("/rss.xml")} class="rounded border border-border px-3 py-1.5 hover:border-accent hover:text-accent transition-colors">RSS</a>
        <a href={categoryPath("life")} class="rounded border border-border px-3 py-1.5 hover:border-accent hover:text-accent transition-colors">生活杂谈</a>
      </div>
    </section>
  </div>
</PageLayout>
