---
import PageLayout from "../layouts/PageLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = (await Promise.all([
  ...await getCollection("tech"),
  ...await getCollection("life"),
]))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const techPosts = allPosts.filter((p) => p.data.category === "tech").slice(0, 5);
const lifePosts = allPosts.filter((p) => p.data.category === "life").slice(0, 5);
---

<PageLayout title="Justice's Blog" description="A personal blog for tech & life.">
  <div class="flex items-center gap-4 mb-8">
    <img src="/images/avatar.jpg" alt="Justice" class="w-14 h-14 rounded-full object-cover shrink-0" />
    <div>
      <h1 class="text-xl font-bold font-serif-cn">Justice</h1>
      <p class="text-sm text-fgMuted">HITSZ 大一 · Computer Science</p>
      <div class="flex items-center gap-3 mt-2">
        <div class="flex flex-wrap gap-1.5">
          <span class="rounded bg-accent/10 px-2 py-0.5 text-xs text-accent font-medium">C++学习中</span>
          <span class="rounded bg-accent/10 px-2 py-0.5 text-xs text-accent font-medium">Python入门</span>
          <span class="rounded bg-accent/10 px-2 py-0.5 text-xs text-accent font-medium">算法</span>
          <span class="rounded bg-accent/10 px-2 py-0.5 text-xs text-accent font-medium">AI</span>
          <span class="rounded bg-accent/10 px-2 py-0.5 text-xs text-accent font-medium">硬件折腾</span>
        </div>
        <a href="https://github.com/just1cez" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1 text-fgMuted hover:text-accent transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span class="text-xs">GitHub</span>
        </a>
      </div>
    </div>
  </div>

  <section class="mb-12">
    <h2 class="mb-6 text-xl font-bold border-b border-border pb-2">
      <a href="/tech" class="hover:text-accent transition-colors">Tech</a>
    </h2>
    <div class="space-y-3">
      {techPosts.map((post) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          category={post.data.category}
          description={post.data.description}
          slug={post.id}
        />
      ))}
    </div>
    <a href="/tech" class="mt-3 inline-block text-sm text-accent hover:underline">查看更多 Tech &rarr;</a>
  </section>

  <section>
    <h2 class="mb-6 text-xl font-bold border-b border-border pb-2">
      <a href="/life" class="hover:text-accent transition-colors">Life</a>
    </h2>
    <div class="space-y-3">
      {lifePosts.map((post) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          category={post.data.category}
          description={post.data.description}
          slug={post.id}
        />
      ))}
    </div>
    <a href="/life" class="mt-3 inline-block text-sm text-accent hover:underline">查看更多 Life &rarr;</a>
  </section>
</PageLayout>