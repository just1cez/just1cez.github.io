---
import PageLayout from "../layouts/PageLayout.astro";
import FrostLine from "../components/FrostLine.astro";
import Hero from "../components/react/Hero.tsx";
import ArticleList from "../components/react/ArticleList.tsx";
import { SITE, withBase, tagPath } from "../site.config";
import { getAllPosts, getFeaturedPosts, getFocusTags } from "../lib/posts";
import { toPostItem } from "../lib/toPostItem";

const allPosts = await getAllPosts();
const latestPosts = allPosts.slice(0, 8).map(toPostItem);
const featuredPosts = getFeaturedPosts(allPosts, 5).map(toPostItem);
const focusTags = getFocusTags(allPosts, ["Algorithm", "C++", "AI探索", "学习记录", "PC硬件"], 5);
---

<PageLayout title={SITE.title} description={SITE.description} type="home">
  <div class="space-y-12">
    <section class="space-y-4">
      <Hero client:load />
      <div class="flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-[10px] uppercase tracking-wider text-fgMuted">专注标签:</span>
        {focusTags.map(({ tag, count }) => (
          <a href={tagPath(tag)} class:list={["rounded-full border px-3 py-1 font-serif text-xs transition-all active:scale-95", count > 0 ? "border-border bg-bgSoft text-fg hover:border-accent hover:text-accent" : "border-border bg-bgSoft text-fgMuted"]}>
            #{tag} <span class="opacity-60">{count}</span>
          </a>
        ))}
      </div>
      <FrostLine />
    </section>

    {featuredPosts.length > 0 && (
      <section class="space-y-5">
        <h2 class="flex items-center gap-2 border-b border-border/40 pb-2">
          <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l2.09 5.26L20 9l-4 3.5L17.2 19 12 15.8 6.8 19 8 12.5 4 9l5.91-.74z" /></svg>
          <span class="font-serif text-lg font-bold text-fg">精选文章 / Featured</span>
        </h2>
        <ArticleList client:visible posts={featuredPosts} layout="grid" />
      </section>
    )}

    <section class="space-y-5">
      <h2 class="flex items-center justify-between border-b border-border/40 pb-2">
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accentWarm" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v18l7-4 7 4V3z" /></svg>
          <span class="font-serif text-lg font-bold text-fg">最近文章 / Chronological</span>
        </span>
        <a href={withBase("/archive")} class="font-mono text-[11px] text-accent hover:underline">完整归档 →</a>
      </h2>
      <ArticleList client:visible posts={latestPosts} layout="stack" />
    </section>
  </div>
</PageLayout>
