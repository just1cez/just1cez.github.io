---
import PageLayout from "../layouts/PageLayout.astro";
import SignatureProject from "../components/SignatureProject.astro";
import Hero from "../components/Hero.astro";
import ArticleList from "../components/ArticleList.astro";
import { NOW_LEARNING, SITE, withBase } from "../site.config";
import { getAllPosts, toPostCardItem } from "../lib/posts";

const allPosts = await getAllPosts();
const latestPosts = allPosts.slice(0, 5).map(toPostCardItem);
---

<PageLayout title={SITE.title} description={SITE.description}>
  <Hero />

  <!-- Same column grid as PostLayout, so the sidebar lines up with the post TOC. -->
  <div class="mt-12 grid gap-12 sm:mt-14 lg:grid-cols-[minmax(0,720px)_180px] lg:items-start">
    <section class="min-w-0" aria-labelledby="writing-title">
      <div class="flex items-baseline justify-between">
        <h2 id="writing-title" class="font-serif text-2xl font-semibold text-fg">最近文章</h2>
        <div class="flex gap-4 text-sm text-muted">
          <a href={withBase("/articles")} class="text-link">全部文章</a>
          <a href={withBase("/series")} class="hidden text-link sm:inline">系列</a>
        </div>
      </div>
      <ArticleList posts={latestPosts} />
    </section>

    <aside class="space-y-8 text-sm lg:border-l lg:border-border lg:pl-4 lg:text-xs" aria-label="近况">
      <section aria-labelledby="now-title">
        <h2 id="now-title" class="mb-2 font-semibold text-fg">在学</h2>
        <ul class="space-y-1.5">
          {NOW_LEARNING.map((item) => (
            <li>
              <span class="text-fg">{item.name}</span>
              {item.note && <span class="block text-muted">{item.note}</span>}
            </li>
          ))}
        </ul>
      </section>

      <SignatureProject />
    </aside>
  </div>
</PageLayout>
