---
import PageLayout from "../layouts/PageLayout.astro";
import SignatureProject from "../components/SignatureProject.astro";
import Hero from "../components/Hero.astro";
import ArticleList from "../components/ArticleList.astro";
import { SITE, withBase } from "../site.config";
import { getAllPosts, toPostCardItem } from "../lib/posts";

const allPosts = await getAllPosts();
const latestPosts = allPosts.slice(0, 5).map(toPostCardItem);
---

<PageLayout title={SITE.title} description={SITE.description}>
  <Hero />

  <section class="pt-12 sm:pt-14" aria-labelledby="writing-title">
    <div class="flex items-baseline justify-between border-b border-border pb-3">
      <h2 id="writing-title" class="font-serif text-2xl font-semibold tracking-[-0.025em] text-fg">最近文章</h2>
      <div class="flex gap-4 text-sm text-muted">
        <a href={withBase("/articles")} class="text-link">全部文章</a>
        <a href={withBase("/series")} class="hidden text-link sm:inline">系列</a>
      </div>
    </div>
    <ArticleList posts={latestPosts} />
  </section>

  <SignatureProject />
</PageLayout>
