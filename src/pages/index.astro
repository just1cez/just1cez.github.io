---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Justice's Blog" description="A personal blog for tech & life.">
  <div class="min-h-screen flex flex-col items-center justify-center px-4">
    <div class="flex flex-col items-center text-center">
      <img src="/images/avatar.jpg" alt="Justice" class="w-28 h-28 rounded-full object-cover mb-5" />
      <h1 class="text-3xl font-bold">Justice</h1>
      <p class="text-fgMuted mt-1.5">HITSZ 大一 · Computer Science</p>
      <div class="flex flex-wrap justify-center gap-2 mt-5">
        <span class="rounded bg-accent/10 px-2.5 py-1 text-xs text-accent font-medium">C++学习中</span>
        <span class="rounded bg-accent/10 px-2.5 py-1 text-xs text-accent font-medium">Python入门</span>
        <span class="rounded bg-accent/10 px-2.5 py-1 text-xs text-accent font-medium">算法</span>
        <span class="rounded bg-accent/10 px-2.5 py-1 text-xs text-accent font-medium">AI</span>
        <span class="rounded bg-accent/10 px-2.5 py-1 text-xs text-accent font-medium">硬件折腾</span>
      </div>
      <a href="/blog"
         class="mt-8 inline-flex items-center gap-1.5 rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white hover:bg-accent/90 transition-colors">
        进入博客
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
    <div class="mt-12 flex items-center gap-4">
      <a href="https://github.com/just1cez" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1.5 text-fgMuted hover:text-accent transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span class="text-sm">GitHub</span>
      </a>
    </div>
  </div>
</BaseLayout>