---
import PageLayout from "../layouts/PageLayout.astro";
import PostCard from "../components/PostCard.astro";
import { CATEGORY_META, SITE, categoryPath, postPath, tagPath, withBase } from "../site.config";
import { getAllPosts, getAllTags } from "../lib/posts";

const allPosts = await getAllPosts();

const techPosts = allPosts.filter((p) => p.data.category === "tech").slice(0, 5);
const lifePosts = allPosts.filter((p) => p.data.category === "life").slice(0, 5);
const tags = getAllTags(allPosts).slice(0, 12);
const latestPost = allPosts[0];
---

<PageLayout title={SITE.title} description={SITE.description}>
  <section class="mb-10 border-b border-border pb-8">
    <div class="flex items-start gap-4">
      <img src={withBase(SITE.avatar)} alt="Justice" class="h-16 w-16 shrink-0 rounded-full object-cover" />
      <div class="min-w-0">
        <h1 class="text-2xl font-bold font-serif-cn">{SITE.author}</h1>
        <p class="mt-1 text-sm text-fgMuted">HITSZ 大一 · Computer Science</p>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-fgMuted">
          这里记录我正在学的东西和折腾的玩意儿：技术区写算法、编程和论文阅读，生活区放硬件、游戏和日常观察。
        </p>
      </div>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <a href={withBase("/archive")} class="rounded border border-border p-4 hover:border-accent hover:text-accent transition-colors">
        <span class="block text-2xl font-semibold">{allPosts.length}</span>
        <span class="mt-1 block text-xs text-fgMuted">全部文章</span>
      </a>
      <a href={categoryPath("tech")} class="rounded border border-border p-4 hover:border-accent hover:text-accent transition-colors">
        <span class="block text-2xl font-semibold">{allPosts.filter((p) => p.data.category === "tech").length}</span>
        <span class="mt-1 block text-xs text-fgMuted">{CATEGORY_META.tech.title}</span>
      </a>
      <a href={categoryPath("life")} class="rounded border border-border p-4 hover:border-accent hover:text-accent transition-colors">
        <span class="block text-2xl font-semibold">{allPosts.filter((p) => p.data.category === "life").length}</span>
        <span class="mt-1 block text-xs text-fgMuted">{CATEGORY_META.life.title}</span>
      </a>
    </div>

    {latestPost && (
      <div class="mt-6 rounded border border-border bg-bgSoft p-4">
        <p class="text-xs uppercase tracking-wider text-fgMuted">Latest</p>
        <a href={postPath(latestPost.data.category, latestPost.id)} class="mt-1 block font-medium hover:text-accent transition-colors">
          {latestPost.data.title}
        </a>
        {latestPost.data.description && <p class="mt-1 text-sm text-fgMuted line-clamp-2">{latestPost.data.description}</p>}
      </div>
    )}

    <div class="mt-6 flex flex-wrap gap-2">
      {tags.map(({ tag, count }) => (
        <a href={tagPath(tag)} class="rounded bg-accent/10 px-2.5 py-1 text-xs text-accent font-medium hover:bg-accent hover:text-white transition-colors">
          #{tag} <span class="opacity-70">{count}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="mb-6 text-xl font-bold border-b border-border pb-2">
      <a href={categoryPath("tech")} class="hover:text-accent transition-colors">Tech</a>
    </h2>
    <div class="space-y-3">
      {techPosts.map((post) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          category={post.data.category}
          description={post.data.description}
          slug={post.id}
        />
      ))}
    </div>
    <a href={categoryPath("tech")} class="mt-3 inline-block text-sm text-accent hover:underline">查看更多 Tech &rarr;</a>
  </section>

  <section>
    <h2 class="mb-6 text-xl font-bold border-b border-border pb-2">
      <a href={categoryPath("life")} class="hover:text-accent transition-colors">Life</a>
    </h2>
    <div class="space-y-3">
      {lifePosts.map((post) => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          category={post.data.category}
          description={post.data.description}
          slug={post.id}
        />
      ))}
    </div>
    <a href={categoryPath("life")} class="mt-3 inline-block text-sm text-accent hover:underline">查看更多 Life &rarr;</a>
  </section>
</PageLayout>
