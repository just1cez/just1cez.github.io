---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Toc from "../components/Toc.astro";
import BackToTop from "../components/BackToTop.astro";
import CopyButton from "../components/CopyButton.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import { CATEGORY_META, POST_STAGE_META, SITE, categoryPath, tagPath } from "../site.config";

export interface Props {
  title: string;
  date: Date;
  updated?: Date;
  tags: string[];
  category: "tech" | "life";
  description?: string;
  image?: string;
  canonicalUrl?: string;
  series?: string;
  stage: keyof typeof POST_STAGE_META;
}

const { title, date, updated, tags, category, description, image, canonicalUrl, series, stage } = Astro.props;
const isTech = category === "tech";

const headings = Astro.props.headings ?? [];
const formattedDate = date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const formattedUpdated = updated?.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const articleSchema = canonicalUrl && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url: canonicalUrl,
  image,
  keywords: tags,
  articleSection: CATEGORY_META[category].title,
  author: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.github,
  },
  publisher: {
    "@type": "Person",
    name: SITE.author,
  },
};
---

<BaseLayout title={`${title} - ${SITE.title}`} description={description} type={category} image={image} schema={articleSchema || undefined}>
  <ReadingProgress />
  <Header />
  <div class="mx-auto max-w-5xl px-4 py-8 flex gap-8">
    {headings.length > 0 && (
      <aside class="hidden lg:block w-52 shrink-0">
        <div class="sticky top-20">
          <Toc headings={headings} />
        </div>
      </aside>
    )}
    <div class={`flex-1 min-w-0 ${isTech ? "max-w-3xl" : "max-w-4xl"}`}>
      <article class={isTech ? "prose prose-sm dark:prose-invert prose-tech" : "prose prose-lg dark:prose-invert prose-life"}>
        <header class={`mb-8 border-b border-border pb-6 ${isTech ? "" : "text-center"}`}>
          <h1 class={`font-bold font-serif-cn ${isTech ? "text-2xl" : "text-3xl"}`}>{title}</h1>
          <div class={`mt-3 flex flex-wrap items-center gap-3 text-sm text-fgMuted ${isTech ? "" : "justify-center"}`}>
            <time datetime={date.toISOString()}>{formattedDate}</time>
            {formattedUpdated && <span>更新 {formattedUpdated}</span>}
            <span class="rounded bg-bgSoft px-2 py-0.5 text-xs" title={POST_STAGE_META[stage].description}>{POST_STAGE_META[stage].label}</span>
            {series && <span class="rounded bg-accent/10 px-2 py-0.5 text-xs text-accent">{series}</span>}
            {tags.map((tag) => (
              <a href={tagPath(tag)} class="rounded bg-bgSoft px-2 py-0.5 text-xs hover:text-accent transition-colors">{tag}</a>
            ))}
          </div>
        </header>
        <section class={isTech ? "" : "leading-relaxed"}>
          <slot />
        </section>
        <div class="mt-8 pt-4 border-t border-border">
          <a href={categoryPath(category)} class="text-sm text-accent hover:underline">&larr; 更多{CATEGORY_META[category].title}</a>
        </div>
      </article>
    </div>
  </div>
  <Footer />
  <BackToTop />
  <CopyButton />
  <script is:inline>
  (function(){
    function copyText(value){
      if(navigator.clipboard&&window.isSecureContext){
        return navigator.clipboard.writeText(value);
      }
      var textarea=document.createElement('textarea');
      textarea.value=value;
      textarea.setAttribute('readonly','');
      textarea.style.position='fixed';
      textarea.style.left='-9999px';
      document.body.appendChild(textarea);
      textarea.select();
      try{document.execCommand('copy');}finally{document.body.removeChild(textarea);}
      return Promise.resolve();
    }

    function enhanceHeadings(){
      document.querySelectorAll('article h2[id], article h3[id]').forEach(function(heading){
        if(heading.querySelector('.heading-anchor'))return;
        var anchor=document.createElement('a');
        anchor.className='heading-anchor';
        anchor.href='#'+heading.id;
        anchor.setAttribute('aria-label','复制标题链接');
        anchor.textContent='#';
        anchor.addEventListener('click',function(event){
          event.preventDefault();
          var url=new URL(window.location.href);
          url.hash=heading.id;
          copyText(url.toString()).then(function(){
            anchor.classList.add('copied');
            setTimeout(function(){anchor.classList.remove('copied');},1200);
          });
          history.replaceState(null,'',url);
        });
        heading.appendChild(anchor);
      });
    }
    enhanceHeadings();
    document.addEventListener('astro:after-swap',enhanceHeadings);
  })();
  </script>
</BaseLayout>

<style is:global>
  .astro-code {
    background-color: var(--shiki-dark-bg) !important;
    color: var(--shiki-dark) !important;
  }

  .astro-code span {
    color: var(--shiki-dark) !important;
  }

  html:not(.dark) .astro-code {
    background-color: revert !important;
    color: revert !important;
  }

  html:not(.dark) .astro-code span {
    color: revert !important;
  }

  .prose-tech pre {
    @apply rounded-md text-xs leading-tight my-4;
  }

  .prose-life pre {
    @apply rounded-md my-6;
  }

  pre code {
    counter-reset: line;
    display: block;
  }

  pre code .line {
    display: flex;
    align-items: baseline;
  }

  pre code .line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.5em;
    margin-right: 1em;
    text-align: right;
    color: rgba(248,248,242,0.35);
    user-select: none;
    flex-shrink: 0;
  }

  html:not(.dark) pre code .line::before {
    color: rgba(36,41,46,0.3);
  }

  .katex-display {
    @apply my-4 overflow-x-auto;
  }

  .prose h2,
  .prose h3 {
    scroll-margin-top: 5rem;
  }

  .heading-anchor {
    margin-left: 0.35rem;
    color: var(--color-fg-muted);
    opacity: 0;
    text-decoration: none;
    font-weight: 400;
    transition: color 0.2s, opacity 0.2s;
  }

  h2:hover .heading-anchor,
  h3:hover .heading-anchor,
  .heading-anchor:focus {
    opacity: 1;
  }

  .heading-anchor:hover {
    color: var(--color-accent);
  }

  .heading-anchor.copied {
    opacity: 1;
    color: var(--color-accent-warm);
  }
</style>
