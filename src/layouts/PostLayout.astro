---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Toc from "../components/Toc.astro";
import BackToTop from "../components/BackToTop.astro";
import CopyButton from "../components/CopyButton.astro";

export interface Props {
  title: string;
  date: Date;
  tags: string[];
  category: "tech" | "life";
  description?: string;
}

const { title, date, tags, category, description } = Astro.props;
const isTech = category === "tech";

const headings = Astro.props.headings ?? [];
const formattedDate = date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout title={`${title} - Justice's Blog`} description={description} type={category}>
  <Header />
  <div class="mx-auto max-w-5xl px-4 py-8 flex gap-8">
    {isTech && headings.length > 0 && (
      <aside class="hidden lg:block w-52 shrink-0">
        <div class="sticky top-20">
          <Toc headings={headings} />
        </div>
      </aside>
    )}
    <div class={`flex-1 min-w-0 ${isTech ? "max-w-3xl" : "max-w-4xl"}`}>
      <article class={isTech ? "prose prose-sm dark:prose-invert prose-tech" : "prose prose-lg dark:prose-invert prose-life"}>
        <header class={`mb-8 border-b border-border pb-6 ${isTech ? "" : "text-center"}`}>
          <h1 class={`font-bold font-serif-cn ${isTech ? "text-2xl" : "text-3xl"}`}>{title}</h1>
          <div class={`mt-3 flex items-center gap-3 text-sm text-fgMuted ${isTech ? "" : "justify-center"}`}>
            <time datetime={date.toISOString()}>{formattedDate}</time>
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="rounded bg-bgSoft px-2 py-0.5 text-xs hover:text-accent transition-colors">{tag}</a>
            ))}
          </div>
        </header>
        <section class={isTech ? "" : "leading-relaxed"}>
          <slot />
        </section>
        <div class="mt-8 pt-4 border-t border-border">
          <a href={`/${category}`} class="text-sm text-accent hover:underline">&larr; 更多{isTech ? "技术" : "生活"}</a>
        </div>
      </article>
    </div>
  </div>
  <Footer />
  <BackToTop />
  <CopyButton />
</BaseLayout>

<style is:global>
  .astro-code {
    background-color: var(--shiki-dark-bg) !important;
    color: var(--shiki-dark) !important;
  }

  .astro-code span {
    color: var(--shiki-dark) !important;
  }

  html:not(.dark) .astro-code {
    background-color: revert !important;
    color: revert !important;
  }

  html:not(.dark) .astro-code span {
    color: revert !important;
  }

  .prose-tech pre {
    @apply rounded-md text-xs leading-tight my-4;
  }

  .prose-life pre {
    @apply rounded-md my-6;
  }

  pre code {
    counter-reset: line;
    display: block;
  }

  pre code .line {
    display: flex;
    align-items: baseline;
  }

  pre code .line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.5em;
    margin-right: 1em;
    text-align: right;
    color: rgba(248,248,242,0.35);
    user-select: none;
    flex-shrink: 0;
  }

  html:not(.dark) pre code .line::before {
    color: rgba(36,41,46,0.3);
  }

  .katex-display {
    @apply my-4 overflow-x-auto;
  }
</style>