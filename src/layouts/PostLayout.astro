---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Toc from "../components/Toc.astro";
import BackToTop from "../components/BackToTop.astro";

export interface Props {
  title: string;
  date: Date;
  tags: string[];
  category: "tech" | "life";
  description?: string;
}

const { title, date, tags, category, description } = Astro.props;
const isTech = category === "tech";

const headings = Astro.props.headings ?? [];
const formattedDate = date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout title={`${title} - Justice's Blog`} description={description} type={category}>
  <Header />
  <div class={`mx-auto ${isTech ? "max-w-3xl" : "max-w-4xl"} px-4 py-8`}>
    <article class={isTech ? "prose-tech" : "prose-life"}>
      <header class={`mb-8 border-b border-border pb-6 ${isTech ? "" : "text-center"}`}>
        <h1 class={`font-bold ${isTech ? "text-2xl" : "text-3xl"}`}>{title}</h1>
        <div class={`mt-3 flex items-center gap-3 text-sm text-fgMuted ${isTech ? "" : "justify-center"}`}>
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="rounded bg-bgSoft px-2 py-0.5 text-xs hover:text-accent transition-colors">{tag}</a>
          ))}
        </div>
      </header>
      {isTech && headings.length > 0 && (
        <aside class="hidden lg:block float-right ml-8 mb-8 w-52">
          <Toc headings={headings} />
        </aside>
      )}
      <section class={`clear-right ${isTech ? "" : "leading-relaxed"}`}>
        <slot />
      </section>
      <div class="mt-8 pt-4 border-t border-border">
        <a href={`/${category}`} class="text-sm text-accent hover:underline">&larr; 返回{isTech ? "技术" : "生活"}列表</a>
      </div>
    </article>
  </div>
  <Footer />
  <BackToTop />
</BaseLayout>

<style is:global>
  .prose-tech {
    @apply text-sm leading-snug;
  }
  .prose-tech h2 {
    @apply text-lg font-bold mt-8 mb-3 border-b border-border pb-1;
  }
  .prose-tech h3 {
    @apply text-base font-semibold mt-6 mb-2;
  }
  .prose-tech p {
    @apply mb-3;
  }
  .prose-tech ul, .prose-tech ol {
    @apply mb-3 pl-5;
  }
  .prose-tech li {
    @apply mb-1;
  }
  .prose-tech pre {
    @apply rounded-md text-xs leading-tight p-3 my-3 border border-border;
  }
  .prose-tech table {
    @apply text-xs my-3 w-full;
  }
  .prose-tech th, .prose-tech td {
    @apply border border-border px-2 py-1;
  }
  .prose-tech th {
    @apply bg-bgSoft font-semibold;
  }
  .prose-tech blockquote {
    @apply border-l-2 border-accent pl-3 my-3 text-fgMuted italic;
  }
  .prose-tech a {
    @apply text-accent hover:underline;
  }
  .prose-tech img {
    @apply my-3 rounded;
  }
  .prose-tech code {
    @apply bg-bgSoft rounded px-1 py-0.5 text-sm;
  }

  .prose-life {
    @apply leading-relaxed text-base;
  }
  .prose-life h2 {
    @apply text-2xl font-bold mt-10 mb-4;
  }
  .prose-life h3 {
    @apply text-xl font-semibold mt-8 mb-3;
  }
  .prose-life p {
    @apply mb-4;
  }
  .prose-life ul, .prose-life ol {
    @apply mb-4 pl-6;
  }
  .prose-life li {
    @apply mb-2;
  }
  .prose-life blockquote {
    @apply border-l-4 border-accent pl-4 my-6 text-fgMuted italic text-lg;
  }
  .prose-life a {
    @apply text-accent hover:underline font-medium;
  }
  .prose-life img {
    @apply my-6 rounded-lg shadow-md;
  }
  .prose-life table {
    @apply my-6 w-full;
  }
  .prose-life th, .prose-life td {
    @apply border border-border px-4 py-2;
  }
  .prose-life th {
    @apply bg-bgSoft font-semibold;
  }
  .prose-life code {
    @apply bg-bgSoft rounded px-1 py-0.5 text-sm;
  }

  .katex-display {
    @apply my-4 overflow-x-auto;
  }
</style>