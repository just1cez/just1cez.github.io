---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Toc from "../components/Toc.astro";
import BackToTop from "../components/BackToTop.astro";
import CopyButton from "../components/CopyButton.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import { CATEGORY_META, POST_STAGE_META, SITE, categoryPath, tagPath, withBase } from "../site.config";
import "katex/dist/katex.min.css";

export interface Props {
  title: string;
  date: Date;
  updated?: Date;
  tags: string[];
  category: "tech" | "life";
  description?: string;
  image?: string;
  canonicalUrl?: string;
  series?: string;
  stage: keyof typeof POST_STAGE_META;
  readingMinutes: number;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, date, updated, tags, category, description, image, canonicalUrl, series, stage, readingMinutes } = Astro.props;
const headings = Astro.props.headings ?? [];
const hasToc = headings.some((heading) => heading.depth >= 2 && heading.depth <= 3);
const formattedDate = date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
const formattedUpdated = updated?.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
const schemaImage = new URL(withBase(image ?? SITE.avatar), Astro.site).toString();

const articleSchema = canonicalUrl && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url: canonicalUrl,
  image: schemaImage,
  timeRequired: `PT${readingMinutes}M`,
  keywords: tags,
  articleSection: CATEGORY_META[category].title,
  author: { "@type": "Person", name: SITE.author, url: SITE.github },
  publisher: { "@type": "Person", name: SITE.author },
};
---

<BaseLayout title={`${title} — ${SITE.title}`} description={description} ogType="article" image={image} schema={articleSchema || undefined}>
  <ReadingProgress />
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-1 px-5 py-10 sm:px-8 sm:py-14">
      <div class:list={[hasToc ? "grid gap-12 lg:grid-cols-[minmax(0,720px)_180px] lg:items-start" : "mx-auto max-w-[720px]"]}>
        <article class="post-prose prose prose-base max-w-none dark:prose-invert">
          <header class="not-prose mb-9 border-b border-border pb-7">
            <h1 class="font-serif text-3xl font-semibold leading-tight tracking-[-0.035em] text-fg sm:text-4xl">{title}</h1>
            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
              <time datetime={date.toISOString()}>{formattedDate}</time>
              <span aria-hidden="true">·</span>
              <span>{POST_STAGE_META[stage].label}</span>
              <span aria-hidden="true">·</span>
              <span>约 {readingMinutes} 分钟</span>
              {series && (
                <Fragment>
                  <span aria-hidden="true">·</span>
                  <a href={withBase("/series")} class="hover:text-link">{series}</a>
                </Fragment>
              )}
              {formattedUpdated && (
                <Fragment>
                  <span aria-hidden="true">·</span>
                  <span>更新于 {formattedUpdated}</span>
                </Fragment>
              )}
            </div>
            {tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
                {tags.map((tag) => <a href={tagPath(tag)} class="hover:text-link">#{tag}</a>)}
              </div>
            )}
          </header>

          <slot />

          <div class="not-prose mt-10 border-t border-border pt-5">
            <a href={categoryPath(category)} class="text-sm text-link">← 更多{CATEGORY_META[category].title}</a>
          </div>
        </article>

        {hasToc && (
          <aside class="hidden lg:block">
            <div class="sticky top-8"><Toc headings={headings} /></div>
          </aside>
        )}
      </div>
    </main>
    <Footer />
  </div>
  <BackToTop />
  <CopyButton />
  <script is:inline>
  (function(){
    function copyText(value){
      if(navigator.clipboard&&window.isSecureContext)return navigator.clipboard.writeText(value);
      return Promise.reject(new Error('Clipboard API unavailable'));
    }
    document.querySelectorAll('article h2[id], article h3[id]').forEach(function(heading){
      if(heading.querySelector('.heading-anchor'))return;
      var anchor=document.createElement('a');
      anchor.className='heading-anchor';
      anchor.href='#'+heading.id;
      anchor.setAttribute('aria-label','复制标题链接');
      anchor.textContent='#';
      anchor.addEventListener('click',function(event){
        event.preventDefault();
        var url=new URL(window.location.href);url.hash=heading.id;
        copyText(url.toString()).then(function(){anchor.classList.add('copied');setTimeout(function(){anchor.classList.remove('copied');},1200);}).catch(function(){});
        history.replaceState(null,'',url);
      });
      heading.appendChild(anchor);
    });
  })();
  </script>
</BaseLayout>

<style is:global>
  .post-prose { font-size:1.0625rem; line-height:1.78; }
  .post-prose h2,.post-prose h3 { scroll-margin-top:2rem; }
  .post-prose pre { margin:1.5rem 0; border-radius:4px; font-size:.82rem; line-height:1.55; }
  .post-prose table { display:block; max-width:100%; overflow-x:auto; }
  .astro-code { background-color:var(--shiki-dark-bg)!important; color:var(--shiki-dark)!important; }
  .astro-code span { color:var(--shiki-dark)!important; }
  html:not(.dark) .astro-code { background-color:revert!important; color:revert!important; }
  html:not(.dark) .astro-code span { color:revert!important; }
  pre code { counter-reset:line; display:block; }
  pre code .line { display:flex; align-items:baseline; }
  pre code .line::before {
    counter-increment:line;content:counter(line);display:inline-block;width:2.5em;margin-right:1em;
    flex-shrink:0;color:rgba(248,248,242,.35);text-align:right;user-select:none;
  }
  html:not(.dark) pre code .line::before { color:rgba(36,41,46,.3); }
  .katex-display { margin:1.25rem 0; overflow-x:auto; }
  .post-prose .obsidian-callout {
    margin:1.5rem 0;border-left:2px solid var(--color-link);
    padding:.2rem 0 .2rem 1rem;color:var(--color-muted);
  }
  .post-prose .obsidian-callout p { margin:.35rem 0; }
  .post-prose .obsidian-callout-title { color:var(--color-fg);font-weight:600; }
  .heading-anchor { margin-left:.35rem;color:var(--color-muted);opacity:0;text-decoration:none;font-weight:400; }
  h2:hover .heading-anchor,h3:hover .heading-anchor,.heading-anchor:focus-visible { opacity:1; }
  .heading-anchor:hover,.heading-anchor.copied { color:var(--color-link);opacity:1; }
</style>
