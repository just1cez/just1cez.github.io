---
export interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  schema?: Record<string, unknown>;
}

import { SITE, withBase } from "../site.config";
import "../styles/global.css";

const { title, description = SITE.description, ogType = "website", image = SITE.avatar, schema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(image), Astro.site).toString();
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase("/"), Astro.site).toString(),
  author: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.github,
  },
};
const jsonLd = JSON.stringify(schema ?? defaultSchema);
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={withBase("/rss.xml")} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      (function(){
        function applyTheme(){
          var t=localStorage.getItem('theme');
          if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){
            document.documentElement.classList.add('dark');
          }else{
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
      })();
    </script>
    <script is:inline src={withBase("/frost-trail.js")} defer></script>
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased transition-colors duration-200">
    <slot />
  </body>
</html>
