---
export interface Props {
  prev?: { title: string; slug: string; category: string } | null;
  next?: { title: string; slug: string; category: string } | null;
}
import { postPath } from "../site.config";
const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="not-prose mt-8 grid gap-6 border-t border-border pt-6 sm:grid-cols-2" aria-label="文章导航">
    <div>
      {prev && <a href={postPath(prev.category, prev.slug)} class="group block"><span class="block text-xs text-muted">← 上一篇</span><span class="mt-1 block text-sm text-fg group-hover:text-link">{prev.title}</span></a>}
    </div>
    <div class="sm:text-right">
      {next && <a href={postPath(next.category, next.slug)} class="group block"><span class="block text-xs text-muted">下一篇 →</span><span class="mt-1 block text-sm text-fg group-hover:text-link">{next.title}</span></a>}
    </div>
  </nav>
)}
