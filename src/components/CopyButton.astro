<script>
  import '@github/clipboard-copy-element'

  function addCopyButtons() {
    document.querySelectorAll('pre').forEach((pre) => {
      if (pre.parentElement.classList.contains('code-container')) return
      const code = pre.querySelector('code')
      if (!code) return

      const wrapper = document.createElement('div')
      wrapper.className = 'code-container'
      pre.parentNode!.insertBefore(wrapper, pre)
      wrapper.appendChild(pre)

      const language = pre.getAttribute('data-language')
      const filename = pre.getAttribute('data-filename')
      if (language || filename) {
        const label = document.createElement('span')
        label.className = 'code-meta'
        label.textContent = filename ? `${filename}${language ? ` · ${language}` : ''}` : language
        wrapper.appendChild(label)
      }

      const btn = document.createElement('clipboard-copy')
      btn.value = code.textContent ?? ''
      btn.className = 'copy-btn'
      btn.setAttribute('aria-label', '复制代码')
      btn.setAttribute('title', '复制代码')
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>'
      wrapper.appendChild(btn)
    })
  }

  document.addEventListener('clipboard-copy', (e) => {
    const target = e.target as HTMLElement
    const icon = target as HTMLElement
    icon.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
    icon.classList.add('copied')
    setTimeout(() => {
      icon.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>'
      icon.classList.remove('copied')
    }, 1500)
  })

  addCopyButtons()
  document.addEventListener('astro:after-swap', addCopyButtons)
</script>
<style is:global>
  .code-container {
    position: relative;
  }
  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    border-radius: 0.25rem;
    background: rgba(255,255,255,0.08);
    color: #8b949e;
    cursor: pointer;
    opacity: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s, background 0.2s, color 0.2s;
  }
  .code-meta {
    position: absolute;
    top: 0.45rem;
    left: 0.65rem;
    z-index: 10;
    border-radius: 0.25rem;
    background: rgba(255,255,255,0.08);
    padding: 0.15rem 0.4rem;
    color: #8b949e;
    font-size: 0.65rem;
    line-height: 1;
    letter-spacing: 0;
  }
  .code-container pre {
    padding-top: 2rem;
  }
  .code-container:hover .copy-btn {
    opacity: 1;
  }
  .copy-btn:hover {
    background: rgba(255,255,255,0.16);
    color: #e1e4e8;
  }
  .copy-btn:focus-visible {
    opacity: 1;
    outline: 2px solid var(--color-accent-warm);
    outline-offset: 2px;
  }
  .copy-btn.copied {
    opacity: 1;
    color: #3fb950;
  }
  html:not(.dark) .copy-btn {
    background: rgba(0,0,0,0.06);
    color: #6a737d;
  }
  html:not(.dark) .copy-btn:hover {
    background: rgba(0,0,0,0.12);
    color: #24292e;
  }
  html:not(.dark) .copy-btn.copied {
    color: #22863a;
  }
  html:not(.dark) .code-meta {
    background: rgba(0,0,0,0.06);
    color: #6a737d;
  }
  @media (hover: none) {
    .copy-btn {
      opacity: 0.5;
    }
  }
</style>
