---
export interface Props {
  title?: string;
  difficulty?: string;
  complexity?: string;
}

const { title = "算法笔记", difficulty, complexity } = Astro.props;
---

<section class="not-prose my-6 rounded-md border border-border bg-bgSoft p-4">
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Algorithm</p>
  <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
    <h2 class="text-base font-semibold">{title}</h2>
    <div class="flex flex-wrap gap-2 text-xs text-fgMuted">
      {difficulty && <span class="rounded bg-bg px-2 py-1">{difficulty}</span>}
      {complexity && <span class="rounded bg-bg px-2 py-1">{complexity}</span>}
    </div>
  </div>
  <div class="mt-3 text-sm leading-7 text-fgMuted">
    <slot />
  </div>
</section>
