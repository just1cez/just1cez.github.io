---
import ArticleList from "./ArticleList.astro";
import FrostLine from "./FrostLine.astro";
import Pagination from "./Pagination.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { CATEGORY_META, categoryPath } from "../site.config";
import { toPostCardItem } from "../lib/posts";
import type { BlogCategory } from "../site.config";
import type { PostEntry } from "../lib/posts";

export interface Props {
  category: BlogCategory;
  page: {
    data: PostEntry[];
    currentPage: number;
    lastPage: number;
  };
}

const { category, page } = Astro.props;
const items = page.data.map(toPostCardItem);
const isTech = category === "tech";
---

<PageLayout title={`${CATEGORY_META[category].label} - Justice's Blog`} description={CATEGORY_META[category].description}>
  <div class="space-y-8">
    <header class="space-y-2">
      <span class:list={["block font-mono text-xs uppercase tracking-widest", isTech ? "text-accentWarm" : "text-accent"]}>
        {isTech ? "Core Technologies / 系统精研" : "Rest & Reflection / 平衡日常"}
      </span>
      <h1 class="flex items-center gap-2 font-serif text-2xl font-bold text-fg sm:text-3.5xl">
        {isTech ? (
          <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
        ) : (
          <svg class="h-6 w-6 text-accentWarm" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.24 5.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z" /></svg>
        )}
        <span>{CATEGORY_META[category].title}</span>
      </h1>
      <p class="font-serif text-xs italic text-fgMuted">{CATEGORY_META[category].description}</p>
      <FrostLine />
    </header>
    <ArticleList posts={items} layout={isTech ? "stack" : "grid"} />
    <Pagination currentPage={page.currentPage} lastPage={page.lastPage} baseUrl={categoryPath(category)} />
  </div>
</PageLayout>
