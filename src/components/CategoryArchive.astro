---
import ArticleList from "./ArticleList.astro";
import Pagination from "./Pagination.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { CATEGORY_META, SITE, categoryPath } from "../site.config";
import { toPostCardItem } from "../lib/posts";
import type { BlogCategory } from "../site.config";
import type { PostEntry } from "../lib/posts";

export interface Props {
  category: BlogCategory;
  page: {
    data: PostEntry[];
    currentPage: number;
    lastPage: number;
    total?: number;
  };
}

const { category, page } = Astro.props;
const items = page.data.map(toPostCardItem);
const count = page.total ?? items.length;
---

<PageLayout title={`${CATEGORY_META[category].label} — ${SITE.title}`} description={CATEGORY_META[category].description}>
  <header class="page-heading">
    <h1 class="page-title">{CATEGORY_META[category].title}</h1>
    <p class="mt-2 text-sm text-muted">{count} 篇文章</p>
  </header>
  <ArticleList posts={items} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} baseUrl={categoryPath(category)} />
</PageLayout>
