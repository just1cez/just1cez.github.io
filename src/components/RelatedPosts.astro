---
import { CATEGORY_META, postPath } from "../site.config";
import type { PostSummary } from "../lib/posts";
export interface Props { posts: PostSummary[]; }
const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="not-prose mt-10 border-t border-border pt-6">
    <h2 class="font-serif text-lg font-semibold text-fg">相关阅读</h2>
    <ul class="mt-3 divide-y divide-border">
      {posts.map((post) => (
        <li class="py-3">
          <div class="flex items-baseline justify-between gap-4">
            <a href={postPath(post.category, post.slug)} class="text-sm text-fg hover:text-link">{post.title}</a>
            <span class="shrink-0 text-xs text-muted">{CATEGORY_META[post.category].label}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
