---
export interface Props { headings: { depth: number; slug: string; text: string }[]; }
const { headings } = Astro.props;
const filtered = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{filtered.length > 0 && (
  <nav id="toc" class="border-l border-border pl-4 text-xs" aria-label="文章目录">
    <h2 class="mb-2 font-semibold text-fg">目录</h2>
    <ul class="space-y-1.5">
      {filtered.map((heading) => (
        <li class={heading.depth === 3 ? "pl-3" : ""}>
          <a href={`#${heading.slug}`} data-toc-link class="block truncate text-muted hover:text-link">{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script is:inline>
(function(){
  var links=document.querySelectorAll('[data-toc-link]');if(!links.length)return;
  var ids=Array.from(links).map(function(link){return link.getAttribute('href').slice(1);});
  function update(){
    var current=null,position=window.scrollY+100;
    for(var i=ids.length-1;i>=0;i--){var element=document.getElementById(ids[i]);if(element&&element.offsetTop<=position){current=ids[i];break;}}
    links.forEach(function(link){var active=link.getAttribute('href')==='#'+current;link.style.color=active?'var(--color-link)':'';link.style.fontWeight=active?'600':'';});
  }
  window.addEventListener('scroll',update,{passive:true});update();
})();
</script>
