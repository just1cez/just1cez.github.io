---
const repoUrl = "https://github.com/just1cez/personal-command-deck";
const releaseUrl = "https://github.com/just1cez/personal-command-deck/releases";
---

<section id="work" class="scroll-mt-8" aria-labelledby="work-title">
  <h2 id="work-title" class="mb-2 font-semibold text-fg">项目</h2>
  <h3 class="font-serif text-base font-semibold leading-snug text-fg lg:text-sm">Personal Command Deck</h3>
  <p class="mt-1 leading-6 text-muted lg:leading-5">把任务、项目、提醒和常用入口放在同一页的桌面应用。</p>
  <p class="mt-1 text-muted">Electron · React · TypeScript</p>
  <div class="mt-2 flex gap-4">
    <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-link">GitHub</a>
    <a href={releaseUrl} target="_blank" rel="noopener noreferrer" class="text-link">Releases</a>
  </div>
</section>
