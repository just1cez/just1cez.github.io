---
const repoUrl = "https://github.com/just1cez/personal-command-deck";
const releaseUrl = "https://github.com/just1cez/personal-command-deck/releases";
---

<section id="work" class="scroll-mt-8 pt-14 sm:pt-16" aria-labelledby="work-title">
  <div class="flex items-baseline justify-between border-b border-border pb-3">
    <h2 id="work-title" class="font-serif text-2xl font-semibold tracking-[-0.025em] text-fg">项目</h2>
  </div>
  <article class="py-6">
    <p class="text-xs text-muted">Electron · React · TypeScript</p>
    <h3 class="mt-1 font-serif text-xl font-semibold text-fg">Personal Command Deck</h3>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">把任务、项目、提醒和常用入口放在同一页的桌面应用。</p>
    <div class="mt-4 flex gap-5 text-sm">
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-link">GitHub</a>
      <a href={releaseUrl} target="_blank" rel="noopener noreferrer" class="text-link">Releases</a>
    </div>
  </article>
</section>
