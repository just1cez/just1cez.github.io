---
import { SITE, withBase } from "../site.config";
---

<section class="flex items-center gap-4" aria-labelledby="home-title">
  <img src={withBase(SITE.avatar)} alt="Justice 的头像" class="h-16 w-16 shrink-0 rounded-full object-cover mix-blend-multiply dark:mix-blend-normal dark:brightness-90" />
  <div class="min-w-0">
    <h1 id="home-title" class="font-serif text-2xl font-semibold tracking-[-0.025em] text-fg">Justice</h1>
    <p class="mt-1 text-[0.9375rem] leading-6 text-fg">{SITE.intro}</p>
    <div class="mt-2 flex gap-4 text-sm">
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="text-link">GitHub</a>
      <a href={withBase("/rss.xml")} class="text-link">RSS</a>
    </div>
  </div>
</section>
