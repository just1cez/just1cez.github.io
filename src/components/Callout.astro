---
export interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}

const { type = "note", title } = Astro.props;
const meta = {
  note: { label: "Note", className: "border-accent/40 bg-accent/5 text-accent" },
  tip: { label: "Tip", className: "border-emerald-500/40 bg-emerald-500/5 text-emerald-500" },
  warning: { label: "Warning", className: "border-amber-500/50 bg-amber-500/5 text-amber-500" },
}[type];
---

<aside class={`my-5 rounded-md border p-4 ${meta.className}`}>
  <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em]">{title ?? meta.label}</p>
  <div class="text-sm leading-7 text-fg">
    <slot />
  </div>
</aside>
