---
import { SITE, withBase } from "../site.config";
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-5 py-7 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p>© {year} Justice</p>
    <div class="flex items-center gap-5">
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="hover:text-link">GitHub</a>
      <a href={withBase("/rss.xml")} class="hover:text-link">RSS</a>
    </div>
  </div>
</footer>
