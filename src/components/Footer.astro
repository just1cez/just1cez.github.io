---
import { SITE, withBase } from "../site.config";

const year = new Date().getFullYear();
---

<footer class="mt-auto w-full border-t border-border py-8 transition-colors duration-300">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 md:flex-row md:justify-between">
    <div class="flex flex-col items-center gap-1 text-center md:items-start md:text-left">
      <p class="font-serif text-xs font-medium text-fg">© {year} {SITE.author} · 修行在学海与算法之间</p>
      <p class="font-mono text-[11px] text-fgMuted">此间所述，皆属阶段认知，行旅途中，错漏难免。</p>
    </div>

    <div class="flex flex-col items-center gap-1 md:items-end">
      <p class="font-mono text-[11px] text-fgMuted">Powered by Astro &amp; Tailwind · Inspired by Emilia</p>
      <div class="flex items-center gap-1.5 font-mono text-[11px] text-accentWarm">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z" /></svg>
        <span>月光与冰霜是最好的墨水</span>
      </div>
    </div>

    <div class="flex items-center gap-3 text-fgMuted">
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" title="GitHub" class="hover:text-accent transition-colors">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href={withBase("/rss.xml")} title="订阅 RSS" class="hover:text-accent transition-colors">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 013.1 0 2.18 2.18 0 010 3.1 2.18 2.18 0 01-3.1-3.1zM4 4a16 16 0 0116 16h-2.8A13.2 13.2 0 004 6.8V4zm0 5.6a10.4 10.4 0 0110.4 10.4h-2.8A7.6 7.6 0 004 12.4V9.6z"/></svg>
      </a>
    </div>
  </div>
</footer>
