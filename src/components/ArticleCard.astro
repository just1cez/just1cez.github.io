---
import type { PostCardItem } from "../lib/posts";
export interface Props { post: PostCardItem; showReadingTime?: boolean; }
const { post, showReadingTime = false } = Astro.props;
---

<article class="py-5 sm:grid sm:grid-cols-[112px_minmax(0,1fr)] sm:gap-6">
  <div class="mb-2 text-xs text-muted sm:mb-0 sm:pt-1">
    <time>{post.date}</time>
    <span class="ml-2 sm:ml-0 sm:mt-1 sm:block">{post.categoryLabel}</span>
  </div>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <h3 class="font-serif text-xl font-semibold leading-tight tracking-[-0.015em] text-fg">
        <a href={post.href} class="hover:text-link">{post.title}</a>
      </h3>
      {post.stageLabel && <span class="text-xs text-muted">{post.stageLabel}</span>}
      {showReadingTime && <span class="text-xs text-muted">约 {post.readingMinutes} 分钟</span>}
    </div>
    {post.description && <p class="mt-2 line-clamp-2 max-w-2xl text-sm leading-6 text-muted">{post.description}</p>}
  </div>
</article>
