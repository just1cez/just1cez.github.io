---
export interface Props {
  title: string;
  venue?: string;
  task?: string;
  link?: string;
  code?: string;
}

const { title, venue, task, link, code } = Astro.props;
---

<section class="not-prose my-6 rounded-md border border-border bg-bgSoft p-4">
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Paper</p>
  <h2 class="mt-2 text-base font-semibold">{title}</h2>
  <dl class="mt-3 grid gap-2 text-sm text-fgMuted sm:grid-cols-2">
    {venue && (
      <div>
        <dt class="text-xs uppercase tracking-[0.12em]">Venue</dt>
        <dd class="mt-0.5 text-fg">{venue}</dd>
      </div>
    )}
    {task && (
      <div>
        <dt class="text-xs uppercase tracking-[0.12em]">Task</dt>
        <dd class="mt-0.5 text-fg">{task}</dd>
      </div>
    )}
    {link && (
      <div>
        <dt class="text-xs uppercase tracking-[0.12em]">Paper</dt>
        <dd class="mt-0.5"><a href={link} class="text-accent hover:underline">阅读原文</a></dd>
      </div>
    )}
    {code && (
      <div>
        <dt class="text-xs uppercase tracking-[0.12em]">Code</dt>
        <dd class="mt-0.5"><a href={code} class="text-accent hover:underline">查看代码</a></dd>
      </div>
    )}
  </dl>
</section>
