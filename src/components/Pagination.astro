---
export interface Props {
  currentPage: number;
  lastPage: number;
  baseUrl: string;
}

const { currentPage, lastPage, baseUrl } = Astro.props;

function pageHref(page: number) {
  if (page === 1) return baseUrl;
  return `${baseUrl.replace(/\/$/, "")}/${page}`;
}
---

{lastPage > 1 && (
  <nav class="flex items-center justify-center gap-4 mt-8 text-sm">
    {currentPage > 1 ? (
      <a href={pageHref(currentPage - 1)}
         class="px-3 py-1.5 rounded border border-border hover:border-accent hover:text-accent transition-colors">
        &larr; 上一页
      </a>
    ) : (
      <span class="px-3 py-1.5 rounded border border-border text-fgMuted opacity-40 cursor-not-allowed">&larr; 上一页</span>
    )}
    <span class="text-fgMuted">{currentPage} / {lastPage}</span>
    {currentPage < lastPage ? (
      <a href={pageHref(currentPage + 1)}
         class="px-3 py-1.5 rounded border border-border hover:border-accent hover:text-accent transition-colors">
        下一页 &rarr;
      </a>
    ) : (
      <span class="px-3 py-1.5 rounded border border-border text-fgMuted opacity-40 cursor-not-allowed">下一页 &rarr;</span>
    )}
  </nav>
)}
