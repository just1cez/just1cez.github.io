---
export interface Props {
  currentPage: number;
  lastPage: number;
  baseUrl: string;
}

const { currentPage, lastPage, baseUrl } = Astro.props;

function pageHref(page: number) {
  if (page === 1) return baseUrl;
  return `${baseUrl.replace(/\/$/, "")}/${page}`;
}
---

{lastPage > 1 && (
  <nav class="mt-8 flex items-center justify-center gap-5 border-t border-border pt-6 text-sm" aria-label="分页">
    {currentPage > 1 ? (
      <a href={pageHref(currentPage - 1)}
         class="text-link">
        &larr; 上一页
      </a>
    ) : (
      <span class="text-muted opacity-40">&larr; 上一页</span>
    )}
    <span class="text-muted">{currentPage} / {lastPage}</span>
    {currentPage < lastPage ? (
      <a href={pageHref(currentPage + 1)}
         class="text-link">
        下一页 &rarr;
      </a>
    ) : (
      <span class="text-muted opacity-40">下一页 &rarr;</span>
    )}
  </nav>
)}
