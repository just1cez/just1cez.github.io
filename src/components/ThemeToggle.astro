<button data-theme-toggle type="button" aria-label="切换主题" aria-pressed="false" class="theme-toggle">
  <span class="theme-track" aria-hidden="true">
    <span class="theme-sky"></span>
    <span class="theme-stars"></span>
    <span class="theme-clouds"></span>
    <span class="theme-orb"><span class="theme-sun"></span><span class="theme-moon"></span></span>
  </span>
  <span class="sr-only">切换主题</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    width: 78px;
    height: 32px;
    flex: 0 0 auto;
    align-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }
  .theme-track {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: inherit;
    background: var(--color-surface);
  }
  .theme-sky,.theme-stars,.theme-clouds { position:absolute; inset:0; }
  .theme-sky { background:#e8cfad; transition:background .55s ease; }
  .theme-stars {
    background-image:
      radial-gradient(circle at 18% 34%,#f8f0dd 0 1px,transparent 1.5px),
      radial-gradient(circle at 34% 65%,#dfc8a7 0 1px,transparent 1.5px),
      radial-gradient(circle at 53% 28%,#f8f0dd 0 1px,transparent 1.5px),
      radial-gradient(circle at 69% 58%,#df8a6d 0 1px,transparent 1.5px);
    opacity:0;
    transform:translateY(-30%);
    transition:opacity .3s ease,transform .55s ease;
  }
  .theme-clouds {
    background:
      radial-gradient(circle at 78% 78%,#fffaf0 0 8px,transparent 8.5px),
      radial-gradient(circle at 62% 82%,#f7efe0 0 7px,transparent 7.5px),
      radial-gradient(circle at 47% 84%,#eee2cf 0 6px,transparent 6.5px),
      radial-gradient(circle at 94% 90%,#e5d3b9 0 10px,transparent 10.5px);
    transition:opacity .3s ease,transform .55s ease;
  }
  .theme-orb {
    position:absolute;
    top:3px;
    left:3px;
    width:26px;
    height:26px;
    overflow:hidden;
    border:1px solid rgba(82,54,37,.2);
    border-radius:999px;
    transition:transform .6s cubic-bezier(.26,.97,.2,1.08);
  }
  .theme-sun,.theme-moon { position:absolute; inset:0; border-radius:inherit; }
  .theme-sun { background:linear-gradient(135deg,#f9dc92,#d9834f); transition:opacity .25s ease; }
  .theme-moon {
    background:
      radial-gradient(circle at 34% 32%,rgba(255,255,255,.65),transparent 24%),
      linear-gradient(135deg,#eee7d7,#b8aa91);
    transform:translateX(105%);
    transition:transform .4s ease;
  }
  .theme-toggle:hover .theme-track { border-color:var(--color-link); }
  .theme-toggle:focus-visible { outline:2px solid var(--color-focus); outline-offset:3px; }
  .theme-toggle.is-night .theme-sky,:global(.dark) .theme-toggle .theme-sky { background:linear-gradient(180deg,#181816,#373129); }
  .theme-toggle.is-night .theme-stars,:global(.dark) .theme-toggle .theme-stars { opacity:1; transform:none; }
  .theme-toggle.is-night .theme-clouds,:global(.dark) .theme-toggle .theme-clouds { opacity:.08; transform:translateY(100%); }
  .theme-toggle.is-night .theme-orb,:global(.dark) .theme-toggle .theme-orb { transform:translateX(46px); }
  .theme-toggle.is-night .theme-sun,:global(.dark) .theme-toggle .theme-sun { opacity:0; }
  .theme-toggle.is-night .theme-moon,:global(.dark) .theme-toggle .theme-moon { transform:none; }
  @media (prefers-reduced-motion: reduce) {
    .theme-sky,.theme-stars,.theme-clouds,.theme-orb,.theme-sun,.theme-moon { transition:none; }
  }
</style>

<script is:inline>
(function(){
  function isDark(){return document.documentElement.classList.contains('dark');}
  function sync(){
    var night=isDark();
    document.querySelectorAll('[data-theme-toggle]').forEach(function(button){
      button.classList.toggle('is-night',night);
      button.setAttribute('aria-pressed',night?'true':'false');
      button.setAttribute('aria-label',night?'切换为浅色模式':'切换为深色模式');
    });
  }
  function bind(){
    document.querySelectorAll('[data-theme-toggle]').forEach(function(button){
      if(button.dataset.bound)return;
      button.dataset.bound='1';
      button.addEventListener('click',function(){
        var next=!isDark();
        document.documentElement.classList.toggle('dark',next);
        try{localStorage.setItem('theme',next?'dark':'light');}catch(_){}
        sync();
      });
    });
    sync();
  }
  bind();
  document.addEventListener('astro:page-load',bind);
})();
</script>
