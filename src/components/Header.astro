---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE, categoryPath, normalizePath, withBase, withoutBase } from "../site.config";

const currentPath = normalizePath(withoutBase(Astro.url.pathname));
const isHome = currentPath === "/";
const isBlog = currentPath.startsWith("/tech") || currentPath.startsWith("/life");
const isAbout = currentPath === "/about";
const isSearch = currentPath === "/search";
---

<header class="border-b border-border bg-bg/80 sticky top-0 z-50 backdrop-blur-sm">
  <nav class="mx-auto flex h-14 max-w-4xl items-center justify-between px-4">
    <a href={withBase("/")} class="flex items-center gap-2 text-lg font-bold tracking-tight hover:text-accent transition-colors">
      <img src={withBase(SITE.avatar)} alt="avatar" class="w-8 h-8 rounded-full object-cover" />
      <span>{SITE.title}</span>
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm">
      <a href={withBase("/")} class:list={["hover:text-accent transition-colors", isHome && "text-accent font-medium"]}>
        首页
      </a>
      <div id="blog-menu" class="relative group">
        <button
          id="blog-menu-button"
          type="button"
          class:list={["hover:text-accent transition-colors flex items-center gap-0.5", isBlog && "text-accent font-medium"]}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="blog-menu-dropdown"
        >
          博客
          <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="blog-menu-dropdown" class="hidden group-hover:block absolute top-full left-0 pt-1 w-32">
          <div class="rounded-md border border-border bg-bg shadow-lg py-1">
            <a href={categoryPath("tech")} class="block px-3 py-1.5 text-sm hover:bg-bgSoft hover:text-accent transition-colors">技术笔记</a>
            <a href={categoryPath("life")} class="block px-3 py-1.5 text-sm hover:bg-bgSoft hover:text-accent transition-colors">生活杂谈</a>
          </div>
        </div>
      </div>
      <a href={withBase("/archive")} class:list={["hover:text-accent transition-colors", currentPath === "/archive" && "text-accent font-medium"]}>
        归档
      </a>
      <a href={withBase("/tags")} class:list={["hover:text-accent transition-colors", currentPath.startsWith("/tags") && "text-accent font-medium"]}>
        标签
      </a>
      <a href={withBase("/search")} class:list={["hover:text-accent transition-colors", isSearch && "text-accent font-medium"]}>
        搜索
      </a>
      <a href={withBase("/about")} class:list={["hover:text-accent transition-colors", isAbout && "text-accent font-medium"]}>
        关于
      </a>
      <ThemeToggle />
    </div>
    <button id="menu-btn" type="button" aria-label="Open menu" class="md:hidden rounded-md p-1.5 text-fgMuted hover:text-fg hover:bg-bgSoft transition-colors">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-50 bg-bg/95 backdrop-blur-sm">
    <div class="flex justify-end p-4">
      <button id="menu-close" type="button" aria-label="Close menu" class="rounded-md p-1.5 text-fgMuted hover:text-fg transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="flex flex-col items-center gap-8 mt-16 text-lg">
      <a href={withBase("/")} class:list={["mobile-link hover:text-accent transition-colors", isHome && "text-accent font-medium"]}>首页</a>
      <a href={categoryPath("tech")} class:list={["mobile-link hover:text-accent transition-colors", currentPath.startsWith("/tech") && "text-accent font-medium"]}>技术笔记</a>
      <a href={categoryPath("life")} class:list={["mobile-link hover:text-accent transition-colors", currentPath.startsWith("/life") && "text-accent font-medium"]}>生活杂谈</a>
      <a href={withBase("/archive")} class:list={["mobile-link hover:text-accent transition-colors", currentPath === "/archive" && "text-accent font-medium"]}>归档</a>
      <a href={withBase("/tags")} class:list={["mobile-link hover:text-accent transition-colors", currentPath.startsWith("/tags") && "text-accent font-medium"]}>标签</a>
      <a href={withBase("/search")} class:list={["mobile-link hover:text-accent transition-colors", isSearch && "text-accent font-medium"]}>搜索</a>
      <a href={withBase("/about")} class:list={["mobile-link hover:text-accent transition-colors", isAbout && "text-accent font-medium"]}>关于</a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
(function(){
  var menuBtn=document.getElementById('menu-btn');
  var menuClose=document.getElementById('menu-close');
  var mobileMenu=document.getElementById('mobile-menu');
  if(!menuBtn||!menuClose||!mobileMenu)return;
  function openMenu(){mobileMenu.classList.remove('hidden');menuBtn.setAttribute('aria-expanded','true')}
  function closeMenu(){mobileMenu.classList.add('hidden');menuBtn.setAttribute('aria-expanded','false')}
  menuBtn.setAttribute('aria-expanded','false');
  menuBtn.addEventListener('click',openMenu);
  menuClose.addEventListener('click',closeMenu);
  document.querySelectorAll('.mobile-link').forEach(function(link){
    link.addEventListener('click',closeMenu);
  });

  var blogMenu=document.getElementById('blog-menu');
  var blogButton=document.getElementById('blog-menu-button');
  var blogDropdown=document.getElementById('blog-menu-dropdown');
  if(blogMenu&&blogButton&&blogDropdown){
    function setBlogMenu(open){
      blogDropdown.classList.toggle('hidden',!open);
      blogButton.setAttribute('aria-expanded',String(open));
    }
    blogButton.addEventListener('click',function(event){
      event.stopPropagation();
      setBlogMenu(blogDropdown.classList.contains('hidden'));
    });
    document.addEventListener('click',function(event){
      if(!blogMenu.contains(event.target))setBlogMenu(false);
    });
    document.addEventListener('keydown',function(event){
      if(event.key==='Escape')setBlogMenu(false);
    });
    blogMenu.addEventListener('mouseleave',function(){
      if(document.activeElement!==blogButton)setBlogMenu(false);
    });
  }
})();
</script>
