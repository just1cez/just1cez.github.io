---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE, categoryPath, normalizePath, withBase, withoutBase } from "../site.config";

const currentPath = normalizePath(withoutBase(Astro.url.pathname));
const isTech = currentPath.startsWith("/tech");
const isLife = currentPath.startsWith("/life");
const isAbout = currentPath === "/about";
const isSearch = currentPath === "/search";
const isSeries = currentPath === "/series";

const navItems = [
  { href: categoryPath("tech"), label: "Tech", active: isTech, icon: "book" },
  { href: categoryPath("life"), label: "Life", active: isLife, icon: "compass" },
  { href: withBase("/series"), label: "系列", active: isSeries, icon: "layers" },
  { href: withBase("/search"), label: "搜索", active: isSearch, icon: "search" },
  { href: withBase("/about"), label: "关于", active: isAbout, icon: "info" },
];

const icons = {
  book: "M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z",
  compass: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.24 5.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z",
  clock: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 5v5l3 3",
  layers: "M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5",
  search: "M11 2a9 9 0 1 0 5.6 16.06l4.67 4.67 1.41-1.41-4.67-4.67A9 9 0 0 0 11 2zm0 2a7 7 0 1 1 0 14 7 7 0 0 1 0-14z",
  info: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 5h.01M11 11h1v5h1",
};
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-bg/75 backdrop-blur-md transition-colors duration-300">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <a href={withBase("/")} title="返回首页" class="group flex items-center gap-3 select-none">
      <span class="relative flex h-8 w-8 items-center justify-center overflow-hidden rounded-md border border-border bg-bgSoft transition-all duration-300 group-hover:border-accent">
        <svg class="h-5 w-5 text-accent animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v20M17 5L7 19M19 17L5 7" />
          <circle cx="12" cy="12" r="3" class="fill-bgSoft stroke-accent" />
        </svg>
      </span>
      <span class="flex flex-col">
        <span class="font-serif text-sm font-bold tracking-tight text-fg transition-colors group-hover:text-accent">{SITE.title}</span>
        <span class="font-mono text-[11px] uppercase tracking-wider text-fgMuted">{SITE.subtitle}</span>
      </span>
    </a>
    <div class="hidden md:flex items-center gap-1">
      <nav class="flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-1.5 rounded border-b-2 px-3 py-1.5 text-xs font-serif transition-all duration-200",
              item.active
                ? "text-accent border-accent bg-bgSoft/40"
                : "text-fgMuted border-transparent hover:text-fg hover:bg-bgSoft/30",
            ]}
          >
            <svg class="h-3.5 w-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[item.icon]} /></svg>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <span class="mx-1 h-4 w-px bg-border/60"></span>
      <ThemeToggle />
    </div>

    <button id="menu-btn" type="button" aria-label="Open menu" class="md:hidden rounded-md p-1.5 text-fgMuted hover:text-fg hover:bg-bgSoft transition-colors">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-50 bg-bg/95 backdrop-blur-sm">
    <div class="flex justify-end p-4">
      <button id="menu-close" type="button" aria-label="Close menu" class="rounded-md p-1.5 text-fgMuted hover:text-fg transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="flex flex-col items-center gap-8 mt-16 text-lg font-serif">
      {navItems.map((item) => (
        <a href={item.href} class:list={["mobile-link hover:text-accent transition-colors", item.active && "text-accent font-medium"]}>{item.label}</a>
      ))}
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
(function(){
  function bind(){
    var menuBtn=document.getElementById('menu-btn');
    var menuClose=document.getElementById('menu-close');
    var mobileMenu=document.getElementById('mobile-menu');
    if(!menuBtn||!menuClose||!mobileMenu)return;
    function openMenu(){mobileMenu.classList.remove('hidden');menuBtn.setAttribute('aria-expanded','true')}
    function closeMenu(){mobileMenu.classList.add('hidden');menuBtn.setAttribute('aria-expanded','false')}
    menuBtn.setAttribute('aria-expanded','false');
    menuBtn.addEventListener('click',openMenu);
    menuClose.addEventListener('click',closeMenu);
    document.querySelectorAll('.mobile-link').forEach(function(link){
      link.addEventListener('click',closeMenu);
    });
  }
  bind();
  document.addEventListener('astro:after-swap',bind);
})();
</script>
