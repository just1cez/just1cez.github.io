---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE, normalizePath, withBase, withoutBase } from "../site.config";

const currentPath = normalizePath(withoutBase(Astro.url.pathname));
const navItems = [
  {
    href: withBase("/articles"),
    label: "文章",
    active: ["/articles", "/tech", "/life", "/series", "/tags"].some((path) => currentPath.startsWith(path)),
  },
  { href: withBase("/#work"), label: "项目", active: false },
  { href: withBase("/about"), label: "关于", active: currentPath === "/about" },
  { href: withBase("/search"), label: "搜索", active: currentPath === "/search" },
];
---

<header class="w-full border-b border-border bg-bg">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href={withBase("/")} class="font-serif text-lg font-semibold tracking-[-0.02em] text-fg hover:text-link" aria-label={`${SITE.author} 首页`}>
      Justice
    </a>

    <div class="hidden items-center gap-7 md:flex">
      <nav class="flex items-center gap-6" aria-label="主导航">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "border-b py-1 text-sm",
              item.active ? "border-link text-fg" : "border-transparent text-muted hover:border-border hover:text-fg",
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <ThemeToggle />
    </div>

    <button id="menu-btn" type="button" aria-label="打开菜单" aria-controls="mobile-menu" aria-expanded="false" class="flex h-10 items-center border-b border-border px-1 text-sm text-muted hover:border-link hover:text-fg md:hidden">
      菜单
    </button>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-50 hidden bg-bg px-6 py-5 md:hidden" role="dialog" aria-modal="true" aria-label="移动导航菜单" aria-hidden="true" tabindex="-1">
  <div class="mx-auto flex max-w-lg items-center justify-between border-b border-border pb-5">
    <span class="font-serif text-xl font-semibold text-fg">Justice</span>
    <button id="menu-close" type="button" aria-label="关闭菜单" class="h-10 border-b border-border px-1 text-sm text-muted hover:border-link hover:text-fg">关闭</button>
  </div>
  <nav class="mx-auto mt-10 flex max-w-lg flex-col" aria-label="移动导航">
    {navItems.map((item) => (
      <a href={item.href} class="mobile-link border-b border-border py-5 font-serif text-2xl text-fg hover:text-link">
        {item.label}
      </a>
    ))}
    <div class="mt-8"><ThemeToggle /></div>
  </nav>
</div>

<script is:inline>
(function(){
  var previousFocus=null;
  var inertElements=[];
  function focusable(container){
    return Array.from(container.querySelectorAll('a[href],button:not([disabled]),[tabindex]:not([tabindex="-1"])'));
  }
  function setOpen(open){
    var button=document.getElementById('menu-btn');
    var close=document.getElementById('menu-close');
    var menu=document.getElementById('mobile-menu');
    if(!button||!close||!menu)return;
    menu.classList.toggle('hidden',!open);
    menu.setAttribute('aria-hidden',open?'false':'true');
    button.setAttribute('aria-expanded',open?'true':'false');
    document.body.style.overflow=open?'hidden':'';
    if(open){
      previousFocus=document.activeElement;
      inertElements=Array.from(menu.parentElement.children).filter(function(node){return node!==menu&&node.tagName!=='SCRIPT';});
      inertElements.forEach(function(node){node.setAttribute('inert','');});
      requestAnimationFrame(function(){close.focus();});
    }else{
      inertElements.forEach(function(node){node.removeAttribute('inert');});
      inertElements=[];
      if(previousFocus&&typeof previousFocus.focus==='function')previousFocus.focus();
      previousFocus=null;
    }
  }
  function bind(){
    var button=document.getElementById('menu-btn');
    var close=document.getElementById('menu-close');
    var menu=document.getElementById('mobile-menu');
    if(!button||!close||!menu)return;
    if(!button.dataset.bound){button.dataset.bound='1';button.addEventListener('click',function(){setOpen(true);});}
    if(!close.dataset.bound){close.dataset.bound='1';close.addEventListener('click',function(){setOpen(false);});}
    if(!menu.dataset.bound){
      menu.dataset.bound='1';
      menu.addEventListener('keydown',function(event){
        if(event.key==='Escape'){setOpen(false);return;}
        if(event.key!=='Tab')return;
        var items=focusable(menu); if(!items.length)return;
        var first=items[0],last=items[items.length-1];
        if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}
        else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}
      });
    }
    document.querySelectorAll('.mobile-link').forEach(function(link){
      if(!link.dataset.bound){link.dataset.bound='1';link.addEventListener('click',function(){setOpen(false);});}
    });
  }
  bind();
})();
</script>
